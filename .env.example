# ---------------------------------------------------------------------------
# trace - environment configuration
# Copy to .env before the first `docker compose up`. Only JWT_SECRET and
# GEMINI_API_KEY have no usable default.
# ---------------------------------------------------------------------------

# --- Secrets ---------------------------------------------------------------
# Signs the session JWT stored in the httpOnly cookie.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Google AI Studio key, free tier. Drives query analysis, chunk grading,
# synthesis and image captioning. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Read only when LLM_PROVIDER=openai.
OPENAI_API_KEY=

# Optional. Read only when WEB_SEARCH_PROVIDER=tavily; the duckduckgo
# provider is the default and needs no key.
TAVILY_API_KEY=

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
ML_LOG_LEVEL=info

# --- Host port bindings ----------------------------------------------------
# Change only if a port is already taken on your machine.
API_PORT=8080
# 5174 rather than Vite's default 5173, which collides silently with any
# other Vite project already running on the host. See the README.
WEB_PORT=5174
ML_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=trace
POSTGRES_PASSWORD=trace
POSTGRES_DB=trace
# The api container applies checked-in Drizzle migrations on boot. Set false
# to run `pnpm db:migrate` by hand instead.
RUN_MIGRATIONS_ON_BOOT=true

# --- Qdrant ----------------------------------------------------------------
# Created idempotently on api startup with named vectors dense(384, cosine),
# clip(512, cosine) and a bm25 sparse vector using the idf modifier.
QDRANT_COLLECTION=chunks

# --- Web and CORS ----------------------------------------------------------
CORS_ORIGIN=http://localhost:5174
VITE_API_URL=http://localhost:8080
# Set true only when serving over HTTPS.
COOKIE_SECURE=false

# --- Uploads and URL ingestion ---------------------------------------------
# 512 MB. Uploads stream to the shared volume, never through memory.
MAX_UPLOAD_BYTES=536870912
# 2 MB ceiling on a fetched URL body, enforced while streaming.
MAX_URL_BYTES=2097152
# Escape hatch for ingesting an intranet URL. Leave false: true disables the
# SSRF guard that blocks localhost, private, loopback and link-local targets.
ALLOW_PRIVATE_URLS=false

# --- Connected mailboxes ---------------------------------------------------
# A knowledge base can keep reading an IMAP mailbox. Gmail works with an app
# password (2-Step Verification must be on, then create one at
# myaccount.google.com/apppasswords) — not the account password, and not the
# Gmail API, whose restricted scopes need a verified app: an unverified one
# hands back refresh tokens that expire after seven days.
# Credentials are entered in the interface and stored encrypted with a key
# derived from JWT_SECRET, so they never appear in this file.
#
# How often each connected mailbox is polled, in seconds.
MAILBOX_POLL_SECONDS=300
# Messages per sync pass. Caps the first import of a large mailbox; the rest
# arrives on the following polls.
MAILBOX_BATCH_SIZE=200
# 25 MB, matching Gmail's own attachment ceiling.
MAILBOX_MAX_ATTACHMENT_BYTES=26214400
# Escape hatch for an intranet mail server. Leave false: true disables the
# address guard that stops a mail host resolving to a private range.
ALLOW_PRIVATE_MAILBOX_HOSTS=false

# --- Provider ---------------------------------------------------------------
# groq | gemini | openai. Groq is the default for one reason: its free tier
# allows roughly a thousand requests a day against Gemini's twenty. That is the
# difference between an evaluation you can run and one you cannot — the sample
# dataset is about a hundred and thirty requests across both modes.
# Free key, no card: https://console.groq.com/keys
LLM_PROVIDER=groq
# Required when LLM_PROVIDER=groq. Free, no card: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Query analysis and chunk grading. Structured, high-volume, far less sensitive
# to model strength than the answer a person reads.
GROQ_FAST_MODEL=llama-3.1-8b-instant
# Groq meters per minute rather than per day at any level that matters here.
GROQ_RPM=28

# --- LLM -------------------------------------------------------------------
# gemini | openai
GEMINI_MODEL=gemini-3.8-flash
# Query analysis and chunk grading run here instead. The free-tier request
# quota is enforced per model, so putting the structured, high-volume calls on
# a second model roughly doubles what one minute can do.
GEMINI_FAST_MODEL=gemini-3.1-flash-lite
GEMINI_CAPTION_MODEL=gemini-3.8-flash
OPENAI_MODEL=gpt-4o-mini
# Token-bucket ceiling on LLM requests per minute. The Gemini free tier allows
# five requests per minute per model, and the API reports its own retry delay
# on a 429, which the provider honours. Raise this only with a paid key.
LLM_RPM=5

# --- Local fallback when the daily quota is gone ---------------------------
# none | ollama. With 'ollama', an exhausted *daily* quota routes the loop to a
# local model instead of failing the answer. A per-minute 429 is still waited
# out: abandoning the better model over a few seconds of delay would be the
# wrong trade. Every guarantee survives the switch, because citation resolution
# and abstention happen after synthesis regardless of what produced the text.
#
# Start it with:  docker compose --profile local-llm up
# Pull the weights once it is up:
#   docker compose exec ollama ollama pull qwen3:4b
#   docker compose exec ollama ollama pull qwen3:1.7b
LLM_FALLBACK_PROVIDER=none
OLLAMA_URL=http://ollama:11434
# Synthesis and the classification path, same split as the hosted models.
OLLAMA_MODEL=qwen3:4b
OLLAMA_FAST_MODEL=qwen3:1.7b
# How long before the hosted provider is probed again. A daily allowance does
# come back, and guessing its reset timezone is worse than probing hourly.
LLM_FALLBACK_COOLDOWN_MINUTES=60
# Retries on 429 and 5xx, exponential backoff with jitter.
LLM_MAX_RETRIES=4

# --- Agentic loop ----------------------------------------------------------
# Hard cap on retrieve -> grade -> rewrite cycles before abstaining.
AGENT_MAX_ITERATIONS=3
# Sufficiency gate. Both are swept during evaluation to plot false-answer
# rate against over-abstention rate, which is why they are config and not
# constants in sufficiency.ts.
SUFFICIENCY_MIN_RELEVANT_CHUNKS=2
SUFFICIENCY_MIN_SCORE=0.55
# Chunks handed to the grader after fusion.
RETRIEVAL_TOP_K=12
# Candidates each prefetch branch (dense, bm25) pulls before RRF fusion.
RETRIEVAL_PREFETCH_K=40
# duckduckgo | tavily | none
WEB_SEARCH_PROVIDER=duckduckgo

# --- Ingestion -------------------------------------------------------------
# Chunk target and overlap in characters. Splits land on sentence boundaries
# and carry page and timestamp metadata through untouched.
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=150
# Parallel ingestion jobs. Whisper and OCR are the memory-hungry steps; raise
# only if you have RAM to spare.
INGEST_CONCURRENCY=2

# --- ML service ------------------------------------------------------------
# All CPU-only. First use downloads weights into the ml-models volume.
TEXT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
# tiny | base | small. base is the accuracy/speed sweet spot on a laptop.
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
# A PDF page yielding fewer extractable characters than this is treated as
# scanned and routed through OCR.
PDF_OCR_CHAR_THRESHOLD=40
PDF_OCR_DPI=200
# Seconds between sampled video keyframes.
VIDEO_KEYFRAME_INTERVAL_SEC=30
# Threads each ONNX and CTranslate2 model may use. Roughly half your cores.
ML_OMP_NUM_THREADS=4
# Blocking model work runs here, never on the FastAPI event loop. Keep low:
# each worker can hold a whisper decode in memory.
ML_THREADPOOL_WORKERS=2
# Last-resort path for formats the local pipeline cannot parse. Requires
# GEMINI_API_KEY; set false to guarantee the pipeline stays fully offline.
GEMINI_FILE_API_FALLBACK=true
