# Dummy configuration for `pnpm test`.
#
# Most tests here are pure and config-free by design, but a few exercise code
# that legitimately reads configuration (chunk sizes, retry counts). Those still
# have to get past environment validation, and inheriting the developer's real
# environment made the suite fail whenever a default changed — which is how
# switching the default provider to groq broke it.
#
# None of these values reach a network. No test makes a request.
NODE_ENV=test
JWT_SECRET=test-secret-that-is-long-enough
DATABASE_URL=postgres://test:test@localhost:5432/test
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
ML_SERVICE_URL=http://localhost:8000
LLM_PROVIDER=groq
GROQ_API_KEY=test-key
GEMINI_API_KEY=test-key
