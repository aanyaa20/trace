{
  "name": "@trace/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "dev:worker": "tsx watch --clear-screen=false src/queue/worker.ts",
    "eval": "tsx src/eval/run.ts",
    "retrieve": "tsx src/scripts/retrieve.ts",
    "seed": "tsx src/scripts/seed.ts",
    "start": "node dist/index.js",
    "start:worker": "node dist/queue/worker.js",
    "test": "node --test --env-file=.env.test --import tsx \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/jwt": "10.2.2",
    "@fastify/multipart": "10.1.1",
    "@google/genai": "2.22.0",
    "@qdrant/js-client-rest": "1.19.0",
    "@trace/contracts": "workspace:*",
    "argon2": "0.45.1",
    "bullmq": "6.3.6",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.4",
    "fastify-plugin": "6.0.0",
    "imapflow": "2.0.5",
    "ioredis": "6.0.0",
    "mailparser": "3.9.28",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/mailparser": "3.4.6",
    "@types/node": "22.20.2",
    "drizzle-kit": "0.31.10",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
